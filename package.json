{
  "name": "carecircle-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @carecircle/* dev",
    "build": "pnpm --filter @carecircle/* build",
    "lint": "pnpm --filter @carecircle/* lint",
    "test": "pnpm --filter @carecircle/* test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
